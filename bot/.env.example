# ── Обязательно ────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=111111111

# ── Оплата ─────────────────────────────────────────────────
# stars    — Telegram Stars, автопродление каждые 30 дней (рекомендую)
# provider — рубли через ЮKassa и др., оплата на период + напоминания о продлении
PAYMENT_MODE=stars

# Только для PAYMENT_MODE=provider: токен платёжки из @BotFather → Payments
PROVIDER_TOKEN=
# 1 — передавать данные для чека 54-ФЗ в ЮKassa (попросит email у покупателя)
YOOKASSA_RECEIPT=1

# ── Доступ ─────────────────────────────────────────────────
# ID закрытого канала/чата клуба (вида -100...). Бот должен быть там админом
# с правами «Приглашать» и «Блокировать». Пусто — без канала.
CHANNEL_ID=

# Ссылка на мини-приложение «Барометр состояния» (https://...)
MINIAPP_URL=

# ── Прочее ─────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
# Сколько часов ждать продления после окончания, прежде чем закрыть доступ
GRACE_HOURS=12
DB_PATH=bot.db
CONTENT_PATH=content.json
